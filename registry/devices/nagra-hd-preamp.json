  "connection": {
    "rs232": {
      "baud": 115200,
      "dataBits": 8,
      "parity": "none",
      "stopBits": 1,
      "flowControl": "none",
      "cable": "unknown",
      "connector": "SUB-D9, on the POWER SUPPLY chassis",
      "note": "The serial port is on the rear of the power supply chassis, not the audio chassis — a two-box unit, and the audio box has no serial socket. The manual gives the framing but does not state whether a straight-through or null-modem cable is required, and publishes no pinout, so the cable is recorded as unknown rather than assumed. Nagra Customer Care (customers@nagraaudio.com, 11 Aug 2026) confirmed the RS-232 section and pinning diagram are on page 28 of the official manual; the pin graphic did not survive PDF text extraction."
    },
    "ir": {
      "protocol": "rc5",
      "address": "16",
      "oneWay": true,
      "note": "Philips RC-5, device group 16 as a preamplifier. The bundled remote also drives a Nagra CD player on group 20. Older Nagra RCU / RCU-II remotes use RECS-80 instead and need an internal change by a dealer."
    }
  },
